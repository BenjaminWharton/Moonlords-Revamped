//--------------------------------------------------------------------------------------------------
// Trigger: pickhero
//--------------------------------------------------------------------------------------------------
bool gt_pickhero_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_spawnpoint;
    int lv_player;
    bool lv_condition;
    int lv_heroNum;
    int lv_winDifficulty;
    int lv_achievements;

    // Automatic Variable Declarations
    const int auto7A5A0F6A_ae = gv_hEROCOUNT;
    int auto7A5A0F6A_var;

    // Variable Initialization
    lv_spawnpoint = Point(59.0, 47.0);
    lv_player = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_heroPickDialog))) {
            return false;
        }

        if (!((gv_hero[lv_player] == null))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto7A5A0F6A_var = 0;
    for ( ; auto7A5A0F6A_var <= auto7A5A0F6A_ae; auto7A5A0F6A_var += 1 ) {
        if ((EventDialogControl() == gv_heroPickButtons[auto7A5A0F6A_var].lv_dialogItem)) {
            lv_heroNum = auto7A5A0F6A_var;
            lv_winDifficulty = gv_heroPickButtons[lv_heroNum].lv_winDifficulty;
            lv_achievements = gv_heroPickButtons[lv_heroNum].lv_achievements;
            lv_condition = true;
        }

    }
    if ((lv_condition == false)) {
        return true;
    }

    if ((PlayerHandle(lv_player) != "")) {
        if ((gf_HeroUnlockReq(lv_winDifficulty, lv_achievements, lv_player) == false)) {
            UIDisplayMessage(PlayerGroupSingle(lv_player), c_messageAreaSubtitle, StringExternal("Param/Value/78C7A987"));
            return true;
        }

    }

    DialogSetVisible(gv_heroPickDialog, PlayerGroupSingle(lv_player), false);
    if ((gv_mode == 0)) {
        lv_spawnpoint = Point(239.0, 8.0);
    }

    if ((lv_heroNum == ge_Heroes_Fire)) {
        UnitCreate(1, "FireHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogFire(lv_player);
        gf_bankaddtoint(gv_zbanks[lv_player], "firehero", "statscounter", 1);
    }

    if ((lv_heroNum == ge_Heroes_Lightning)) {
