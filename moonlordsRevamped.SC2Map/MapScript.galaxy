        if (!((UnitGetOwner(EventUnit()) == gv_eNEMYPLAYER))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (((lv_type == "Zergling") || (lv_type == "HotSRaptor") || (lv_type == "HotSSplitterlingMedium") || (lv_type == "Roachling") || (lv_type == "Baneling") || (lv_type == "Larva") || (lv_type == "Overlord") || (lv_type == "Broodling"))) {
