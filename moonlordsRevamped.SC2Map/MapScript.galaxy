    Wait(0.125, c_timeGame);
    UnitBehaviorAdd(lp_unit, "MLPowerField", lp_unit, 1);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "PowerFieldPylon", c_unitCreateIgnorePlacement, 5, UnitGetPosition(lp_unit));
