    gt_TalentButtonPressed = TriggerCreate("gt_TalentButtonPressed_Func");
    TriggerAddEventDialogControl(gt_TalentButtonPressed, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: RewardButtonPressed
//--------------------------------------------------------------------------------------------------
bool gt_RewardButtonPressed_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_pnum;
    int lv_buttonnumber;
    int lv_heroversion;
    int lv_i;

    // Automatic Variable Declarations
    int autoA91054EE_n;
    int autoA91054EE_i;

    // Variable Initialization
    lv_pnum = EventPlayer();
    lv_buttonnumber = -1;

    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_rewardDialog))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    while ((lv_i < 25)) {
        if ((EventDialogControl() == gv_rewardButtons[lv_i])) {
            lv_buttonnumber = lv_i;
            lv_i = 25;
        }

        lv_i += 1;
    }
    if ((lv_buttonnumber == -1)) {
        return true;
    }

    autoA91054EE_n = gv_rewardSpendMultiplier[lv_pnum];
    for (autoA91054EE_i = 1; autoA91054EE_i <= autoA91054EE_n; autoA91054EE_i += 1) {
        if ((((lv_buttonnumber < 5) && (gf_rewardgetprice(lv_pnum, 0) <= gv_rewardUnspend[lv_pnum])) || ((lv_buttonnumber < 10) && (lv_buttonnumber >= 5) && (gf_rewardgetprice(lv_pnum, 5) <= gv_rewardUnspend[lv_pnum])))) {
            gf_rewardbuy(lv_pnum, lv_buttonnumber);
        }

    }
    if ((lv_buttonnumber < 15) && (lv_buttonnumber >= 10) && (gf_rewardgetprice(lv_pnum, 10) <= gv_rewardUnspend[lv_pnum])) {
        gf_rewardbuy(lv_pnum, lv_buttonnumber);
    }

    if ((lv_buttonnumber == 20)) {
        gf_rewardreset(lv_pnum);
    }

    if ((lv_buttonnumber == 24)) {
        if ((gv_rewardSpendMultiplier[lv_pnum] == 1)) {
            gv_rewardSpendMultiplier[lv_pnum] = 10;
            libNtve_gf_SetDialogItemText(gv_rewardButtons[24], StringExternal("Param/Value/00F162F5"), PlayerGroupSingle(lv_pnum));
        }
        else {
            gv_rewardSpendMultiplier[lv_pnum] = 1;
            libNtve_gf_SetDialogItemText(gv_rewardButtons[24], StringExternal("Param/Value/7F267D1C"), PlayerGroupSingle(lv_pnum));
        }
    }

    return true;
}

