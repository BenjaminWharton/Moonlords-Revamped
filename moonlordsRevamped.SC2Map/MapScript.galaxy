    if (((lv_type == "HotSNoxious") || (lv_type == "Ultralisk") || (lv_type == "SpineCrawler") || (lv_type == "Infestor"))) {
        gf_gainxp(25.0);
    }

    if (((lv_type == "SwarmQueen2") || (lv_type == "Queen") || (lv_type == "SporeCrawler"))) {
        gf_gainxp(50.0);
    }

    if (((lv_type == "HotSTorrasque") || (lv_type == "SwarmHostSplitA") || (lv_type == "Ultralisk2") || (lv_type == "Metalisk"))) {
        gf_gainxp(100.0);
    }

    if (((lv_type == "Hatchery"))) {
        gf_gainxp(250.0);
        gf_GainReward(1);
    }

    if (((lv_type == "Lair"))) {
        gf_gainxp(1000.0);
        gf_GainReward(1);
        gf_GainReward(1);
    }

    if (((lv_type == "Hive"))) {
        gf_gainxp(5000.0);
        gf_GainReward(1);
        gf_GainReward(1);
        gf_GainReward(1);
        gf_GainReward(1);
    }

    if ((UnitHasBehavior2(lv_unit, "Champion") == true)) {
        gv_equalizerkills += 1;
        autoDAD7ED21_var = 1;
        for ( ; autoDAD7ED21_var <= autoDAD7ED21_ae; autoDAD7ED21_var += 1 ) {
            if ((PlayerStatus(autoDAD7ED21_var) == c_playerStatusActive)) {
                if ((gv_equalizerkills >= gf_achievementgetvalueofnextlevel(48, autoDAD7ED21_var))) {
                    gf_achievementnew(autoDAD7ED21_var, 48);
                }

            }

        }
    }

    return true;
}

