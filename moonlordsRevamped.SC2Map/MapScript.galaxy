    // Automatic Variable Declarations
    const int auto5560F3A9_ae = gv_pLAYERCOUNT;
    int auto5560F3A9_var;

    // Implementation
    auto5560F3A9_var = 1;
    for ( ; auto5560F3A9_var <= auto5560F3A9_ae; auto5560F3A9_var += 1 ) {
        while ((PlayerStatus(auto5560F3A9_var) == c_playerStatusActive) && (gf_achievementgetvalueofnextleveladd(lp_achievementnumber, auto5560F3A9_var, 0) <= lp_amounttocheckfor)) {
            gf_achievementnew(auto5560F3A9_var, lp_achievementnumber);
        }
    }
}

