            lv_i += 1;
            if ((PlayerStatus(lv_i) == c_playerStatusActive) && (gv_talents[8][0][lv_i].lv_dialogItem != c_invalidDialogControlId)) {
                libNtve_gf_SetDialogItemText(gv_talents[8][0][lv_i].lv_dialogItem, gf_GetTalentPointsTextForPlayer(lv_i), PlayerGroupSingle(lv_i));
            }

        }
        Wait(1.0, c_timeGame);
    }
    return true;
}

