text gf_getrewardinfo (int lp_player) {
    // Variable Declarations
    int lv_i;
    text lv_returntext;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    while ((lv_i <= 14)) {
        lv_returntext = (lv_returntext + gf_getrewardtext(lv_i) + IntToText(gv_rewardUsed[lp_player][lv_i]));
        if ((lv_i < 14)) {
            lv_returntext = (lv_returntext + StringExternal("Param/Value/8674AA2A"));
        }

        lv_i = lv_i+1;
    }
    return lv_returntext;
}

