//--------------------------------------------------------------------------------------------------
// Trigger: SelectModeClick
//--------------------------------------------------------------------------------------------------
bool gt_SelectModeClick_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = EventPlayer();

    // Conditions
    if (testConds) {
        if (!(((EventDialogControl() == gv_rewardButtons[1]) || (EventDialogControl() == gv_rewardButtons[2]) || (EventDialogControl() == gv_rewardButtons[3])))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_hasVoted[lv_player] > 0)) {
        gf_UndoVote(lv_player, false);
    }

    if ((EventDialogControl() == gv_rewardButtons[1])) {
        gv_hasVoted[lv_player] = 1;
        gv_exploreVote += 1;
    }

    if ((EventDialogControl() == gv_rewardButtons[2])) {
        gv_hasVoted[lv_player] = 2;
        gv_challengeVote += 1;
    }

    if ((EventDialogControl() == gv_rewardButtons[3])) {
        gv_hasVoted[lv_player] = 3;
        gv_championVote += 1;
    }

    gf_UpdateVoteButtons();
    return true;
}

