        ObjectiveSetState(lv_quest, c_objectiveStateFailed);
        Wait(10.0, c_timeGame);
        ObjectiveSetState(lv_quest, c_objectiveStateHidden);
    }
    else {
        gv_zevoquests += 1;
        if ((gv_zevoquests == 3)) {
            gf_achievements0killaward(18);
