        gf_gainxp(lv_bossxp);
        auto582684EC_var = 1;
        for ( ; auto582684EC_var <= auto582684EC_ae; auto582684EC_var += 1 ) {
            gf_rewardgainpoints(auto582684EC_var, 1, FixedToInt(gv_difficulty));
        }
    }
    else {
        UnitKill(lv_boss);
        TransmissionSend(lv_pg, TransmissionSource(), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", null, StringExternal("Param/Value/5853F9EE"), (lv_bossname + StringExternal("Param/Value/5B7F1919")), 0.0, c_transmissionDurationAdd, false);
        gf_BossStart(gf_BossSpawnLocation());
    }
    return true;
}

