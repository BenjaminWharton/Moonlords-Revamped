text gf_GetTalentPointsTextForPlayer (int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    return (StringExternal("Param/Value/6E763748") + StringExternal("Param/Value/92F66CEA") + IntToText(gv_talentpointsavailable[lp_player]) + StringExternal("Param/Value/F1C90ED0"));
}

text gf_GetTalentName (text lp_name, string lp_upgrade, int lp_player) {
    // Variable Declarations
    int lv_upgradeLevel;
    int lv_upgradeMax;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_upgradeLevel = TechTreeUpgradeCount(lp_player, lp_upgrade, c_techCountCompleteOnly);
    lv_upgradeMax = CatalogFieldValueGetAsInt(c_gameCatalogUpgrade, lp_upgrade, "MaxLevel", lp_player);

    // Implementation
    return (lp_name + StringExternal("Param/Value/8E94340C") + IntToText(lv_upgradeLevel) + StringExternal("Param/Value/79148F05") + IntToText(lv_upgradeMax));
}

text gf_GetTalentTooltip (structref<gs_Talent> lp_upgrade) {
    // Variable Declarations
    int lv_maxLevel;
    text lv_levelText;
    int lv_i;

    // Automatic Variable Declarations
    int auto7B2AA5E5_n;
    int auto7B2AA5E5_i;

    // Variable Initialization
    lv_maxLevel = CatalogFieldValueGetAsInt(c_gameCatalogUpgrade, lp_upgrade.lv_upgrade, "MaxLevel", c_playerAny);

    // Implementation
    if (((lp_upgrade.lv_req > 0) || (lp_upgrade.lv_reqIncrease > 0))) {
        lv_i = lp_upgrade.lv_req;
        lv_levelText = StringExternal("Param/Value/B14D32CD");
        lv_levelText = (lv_levelText + StringExternal("Param/Value/B1BD5459") + StringExternal("Param/Value/47AE1F78") + StringExternal("Param/Value/C4C4F45C") + IntToText(lv_i));
        if ((lp_upgrade.lv_reqIncrease > 0)) {
            auto7B2AA5E5_n = (lv_maxLevel - 1);
            for (auto7B2AA5E5_i = 1; auto7B2AA5E5_i <= auto7B2AA5E5_n; auto7B2AA5E5_i += 1) {
                lv_i = (lv_i + lp_upgrade.lv_reqIncrease);
                lv_levelText = (lv_levelText + StringExternal("Param/Value/76C76F02") + IntToText(lv_i));
            }
        }

        lv_levelText = (lv_levelText + StringExternal("Param/Value/0292D0CD"));
    }

    return (lp_upgrade.lv_tooltip + lv_levelText);
}

void gf_AwardTalentPoints (int lp_amount) {
    // Automatic Variable Declarations
    const int autoE5EAD03B_ae = gv_pLAYERCOUNT;
    int autoE5EAD03B_var;

    // Implementation
    autoE5EAD03B_var = 0;
    for ( ; autoE5EAD03B_var <= autoE5EAD03B_ae; autoE5EAD03B_var += 1 ) {
        gv_talentpointsavailable[autoE5EAD03B_var] += lp_amount;
        libNtve_gf_SetDialogItemText(gv_resourceLabelTalents, IntToText(gv_talentpointsavailable[autoE5EAD03B_var]), PlayerGroupSingle(autoE5EAD03B_var));
        if ((gv_talentDialogs[autoE5EAD03B_var].lv_dialog != c_invalidDialogId)) {
            libNtve_gf_SetDialogItemText(gv_talents[8][0][autoE5EAD03B_var].lv_dialogItem, gf_GetTalentPointsTextForPlayer(autoE5EAD03B_var), PlayerGroupSingle(autoE5EAD03B_var));
        }

    }
}

void gf_CreateTalentDialog (int lp_player, string lp_background, int lp_heroNum) {
    // Automatic Variable Declarations
    // Implementation
    gv_talentDialogs[lp_player].lv_heroNum = lp_heroNum;
