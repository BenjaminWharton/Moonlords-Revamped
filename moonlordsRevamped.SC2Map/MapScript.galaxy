    libNtve_gf_SetBehaviorCount(lv_boss, "StoneSkin", lv_boss, gv_champion);
    UnitIssueOrder(lv_boss, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(gf_getpylonofstage())), c_orderQueueReplace);
