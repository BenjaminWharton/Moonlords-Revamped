//--------------------------------------------------------------------------------------------------
// Trigger: HeroDeath
//--------------------------------------------------------------------------------------------------
bool gt_HeroDeath_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_type;
    int lv_pnum;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_type = UnitGetType(EventUnit());
    lv_pnum = UnitGetOwner(EventUnit());

    // Conditions
    if (testConds) {
        if (!(((gv_hero[1] == EventUnit()) || (gv_hero[2] == EventUnit()) || (gv_hero[3] == EventUnit()) || (gv_hero[4] == EventUnit())))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_unstoppablekills[lv_pnum] = 0;
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/FAE59F87"));
    gv_zgametime[3] += 60;
    Wait(0.5, c_timeGame);
    if ((gv_mode == 1)) {
        UnitSetPosition(gv_hero[lv_pnum], RegionRandomPoint(RegionCircle(Point(59.0, 47.0), 3.0)), false);
    }
    else {
        UnitSetPosition(gv_hero[lv_pnum], gf_HeroRespawnPoint(), false);
    }
    CameraPan(lv_pnum, UnitGetPosition(gv_hero[lv_pnum]), 1.0, -1, 10, false);
    Wait(1.0, c_timeGame);
    UnitRevive(gv_hero[lv_pnum]);
    UnitCreateEffectUnit(gv_hero[lv_pnum], "FullHeal", gv_hero[lv_pnum]);
    UnitControlGroupAddUnit(lv_pnum, 1, gv_hero[lv_pnum]);
    UnitSelect(gv_hero[lv_pnum], lv_pnum, true);
    gv_deathCount[lv_pnum] += 1;
    libNtve_gf_SetDialogItemText(gv_deathLabels[lv_pnum], IntToText(gv_deathCount[lv_pnum]), PlayerGroupAll());
    UnitBehaviorAdd(gv_hero[lv_pnum], "RestlessPassive", gv_hero[lv_pnum], 1);
    UnitBehaviorAdd(gv_hero[lv_pnum], "RespawnSafety", gv_hero[lv_pnum], 1);
    if ((gv_mode < 1)) {
        gf_TeleportHideShow(gv_hero[lv_pnum]);
    }

    if ((lv_type == "ShadowHero")) {
        UnitBehaviorAdd(gv_hero[lv_pnum], "CloakofFear", gv_hero[lv_pnum], TechTreeUpgradeCount(lv_pnum, "ShadowHeroCloakofFear", c_techCountQueuedOrBetter));
        gf_Shadowwallofdarkness(gv_hero[lv_pnum]);
    }

    if ((lv_type == "LuckHero")) {
        gf_LuckOrbs(gv_hero[lv_pnum], "OrbOfLuck", 4, lv_pnum, 1.25, 3.0, 1.25);
    }

    if ((PlayerStatus(lv_pnum) == c_playerStatusActive)) {
        gf_disguiseunit(gv_hero[lv_pnum], lv_pnum);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_HeroDeath_Init () {
    gt_HeroDeath = TriggerCreate("gt_HeroDeath_Func");
    TriggerAddEventUnitDied(gt_HeroDeath, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: HeroKill
//--------------------------------------------------------------------------------------------------
bool gt_HeroKill_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_type;
    int lv_killplayer;
    unitgroup lv_cooperativegroup;

    // Automatic Variable Declarations
    const int auto867CA257_ae = gv_pLAYERCOUNT;
    int auto867CA257_var;

    // Variable Initialization
    lv_type = UnitGetType(EventUnit());
    lv_killplayer = UnitGetOwner(libNtve_gf_KillingUnit());
    lv_cooperativegroup = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_eNEMYPLAYER))) {
            return false;
        }

        if (!((UnitGetOwner(libNtve_gf_KillingUnit()) < gv_aLLIEDPLAYER))) {
            return false;
        }

        if (!((PlayerStatus(lv_killplayer) == c_playerStatusActive))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_bankaddtoint(gv_zbanks[lv_killplayer], "7", "acm", 1);
    gv_killsThisGame[lv_killplayer] += 1;
    if ((libNtve_gf_UnitGetPropertyKills(libNtve_gf_KillingUnit(), c_unitPropCurrent) > 50000)) {
        UnitSetPropertyFixed(libNtve_gf_KillingUnit(), c_unitPropKills, (UnitGetPropertyInt(libNtve_gf_KillingUnit(), c_unitPropKills, c_unitPropCurrent) - 50000));
    }

    if ((libNtve_gf_KillingUnit() != gv_hero[lv_killplayer])) {
        UnitSetPropertyFixed(gv_hero[lv_killplayer], c_unitPropKills, (UnitGetPropertyFixed(gv_hero[lv_killplayer], c_unitPropKills, c_unitPropCurrent) + 1.0));
    }
    else {
        if ((gv_rewardUsed[lv_killplayer][14] > 0)) {
            UnitCreateEffectUnit(libNtve_gf_KillingUnit(), "TerminatorHeal", libNtve_gf_KillingUnit());
        }

        if ((UnitHasBehavior(libNtve_gf_KillingUnit(), "NinjaCheck") == false)) {
            UnitBehaviorAdd(libNtve_gf_KillingUnit(), "NinjaCheck", libNtve_gf_KillingUnit(), 1);
            gv_ninjakills[lv_killplayer] = 1;
        }
        else {
            gv_ninjakills[lv_killplayer] += 1;
            if ((gv_ninjakills[lv_killplayer] >= 500)) {
                gf_achievementsforplayer(lv_killplayer, 40);
            }

        }
        if ((UnitHasBehavior(libNtve_gf_KillingUnit(), "Gandalfcheck") == false)) {
            UnitBehaviorAdd(libNtve_gf_KillingUnit(), "Gandalfcheck", libNtve_gf_KillingUnit(), 1);
            gv_gandalfkills[lv_killplayer] = 1;
        }
        else {
            gv_gandalfkills[lv_killplayer] += 1;
        }
        if ((gv_gandalfkills[lv_killplayer] >= 500)) {
            gf_achievementsforplayer(lv_killplayer, 43);
        }

        if ((UnitIsAlive(gv_hero[lv_killplayer]) == true) && (UnitHasBehavior(gv_hero[lv_killplayer], "MassacreHelper") == false)) {
            UnitBehaviorAdd(gv_hero[lv_killplayer], "MassacreHelper", gv_hero[lv_killplayer], 1);
        }

        gv_massacrekills[lv_killplayer] += 1;
        auto867CA257_var = 1;
        for ( ; auto867CA257_var <= auto867CA257_ae; auto867CA257_var += 1 ) {
            if ((gv_hero[auto867CA257_var] != null) && (gv_hero[auto867CA257_var] != gv_hero[lv_killplayer])) {
                UnitGroupAdd(lv_cooperativegroup, gv_hero[auto867CA257_var]);
            }

        }
        if ((gv_demolisher != null)) {
            UnitGroupAdd(lv_cooperativegroup, gv_demolisher);
        }

        UnitGroupAddUnitGroup(lv_cooperativegroup, gv_disintegrators);
        if ((UnitGroupCount(lv_cooperativegroup, c_unitCountAlive) > 0) && (gv_hero[lv_killplayer] != null) && (DistanceBetweenPoints(UnitGetPosition(gv_hero[lv_killplayer]), UnitGetPosition(UnitGroupClosestToPoint(lv_cooperativegroup, UnitGetPosition(gv_hero[lv_killplayer])))) < 12.0)) {
            gv_cooperativekills[lv_killplayer] += 1;
            if ((gv_cooperativekills[lv_killplayer] >= 5000)) {
                gf_achievementsforplayer(lv_killplayer, 59);
            }

        }

    }
    if (((gv_zachievementscounterstart[lv_killplayer] + gv_killsThisGame[lv_killplayer]) >= gf_achievementgetvalueofnextlevel(7, lv_killplayer))) {
        gf_achievementnew(lv_killplayer, 7);
    }

    if ((gv_killsThisGame[lv_killplayer] >= gf_achievementgetvalueofnextlevel(10, lv_killplayer))) {
        gf_achievementnew(lv_killplayer, 10);
    }

    gv_unstoppablekills[lv_killplayer] += 1;
    if ((gv_unstoppablekills[lv_killplayer] >= 1000)) {
        gf_achievementsforplayer(lv_killplayer, 20);
    }

    return true;
}

