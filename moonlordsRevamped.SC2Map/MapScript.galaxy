//--------------------------------------------------------------------------------------------------
// Trigger: PartingGift
//--------------------------------------------------------------------------------------------------
bool gt_PartingGift_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_caster;
    int lv_owner;
    point lv_target;
    int lv_split;
    int lv_pierce;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_caster = UnitGroupUnit(UnitGroup("WarpHero", EventPlayer(), RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), 1);
    lv_owner = UnitGetOwner(EventUnit());
    lv_target = UnitGetPosition(EventUnit());
    lv_split = TechTreeUpgradeCount(UnitGetOwner(EventUnit()), "WarpHeroSplit", c_techCountQueuedOrBetter);
    lv_pierce = TechTreeUpgradeCount(UnitGetOwner(EventUnit()), "WarpHeroPierce", c_techCountQueuedOrBetter);

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Decoy"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUpgradeCount(lv_owner, "WarpHeroPartingGift", c_techCountQueuedOrBetter) > 0)) {
        gf_SkillGuidedMissile(lv_caster, lv_owner, PointWithOffsetPolar(lv_target, 1.0, 0.0), lv_target, TechTreeUpgradeCount(lv_owner, "WarpHeroPierce", c_techCountQueuedOrBetter), TechTreeUpgradeCount(lv_owner, "WarpHeroSplit", c_techCountQueuedOrBetter));
        gf_SkillGuidedMissile(lv_caster, lv_owner, PointWithOffsetPolar(lv_target, 1.0, 120.0), lv_target, TechTreeUpgradeCount(lv_owner, "WarpHeroPierce", c_techCountQueuedOrBetter), TechTreeUpgradeCount(lv_owner, "WarpHeroSplit", c_techCountQueuedOrBetter));
        gf_SkillGuidedMissile(lv_caster, lv_owner, PointWithOffsetPolar(lv_target, 1.0, 240.0), lv_target, TechTreeUpgradeCount(lv_owner, "WarpHeroPierce", c_techCountQueuedOrBetter), TechTreeUpgradeCount(lv_owner, "WarpHeroSplit", c_techCountQueuedOrBetter));
    }

    if ((TechTreeUpgradeCount(lv_owner, "WarpHeroPartingGift", c_techCountQueuedOrBetter) > 1)) {
        gf_SkillGuidedMissile(lv_caster, lv_owner, PointWithOffsetPolar(lv_target, 1.0, 60.0), lv_target, TechTreeUpgradeCount(lv_owner, "WarpHeroPierce", c_techCountQueuedOrBetter), TechTreeUpgradeCount(lv_owner, "WarpHeroSplit", c_techCountQueuedOrBetter));
        gf_SkillGuidedMissile(lv_caster, lv_owner, PointWithOffsetPolar(lv_target, 1.0, 180.0), lv_target, TechTreeUpgradeCount(lv_owner, "WarpHeroPierce", c_techCountQueuedOrBetter), TechTreeUpgradeCount(lv_owner, "WarpHeroSplit", c_techCountQueuedOrBetter));
        gf_SkillGuidedMissile(lv_caster, lv_owner, PointWithOffsetPolar(lv_target, 1.0, 300.0), lv_target, TechTreeUpgradeCount(lv_owner, "WarpHeroPierce", c_techCountQueuedOrBetter), TechTreeUpgradeCount(lv_owner, "WarpHeroSplit", c_techCountQueuedOrBetter));
    }

    return true;
}

