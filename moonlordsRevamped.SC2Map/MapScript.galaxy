}

//--------------------------------------------------------------------------------------------------
// Trigger: SkillMultishotCast
//--------------------------------------------------------------------------------------------------
bool gt_SkillMultishotCast_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_delay;
    int lv_i;
    unit lv_caster;
    int lv_owner;
    point lv_target;
    unitgroup lv_grp;
    int lv_j;
    fixed lv_distance;
    point lv_missiletarget;

    // Automatic Variable Declarations
    int autoA1EF4423_n;
    int autoA1EF4423_i;
    int auto41A4407D_n;
    int auto41A4407D_i;

    // Variable Initialization
    lv_caster = EventUnit();
    lv_owner = UnitGetOwner(EventUnit());
    lv_target = EventUnitTargetPoint();
    lv_grp = UnitGroupEmpty();
    lv_missiletarget = EventUnitTargetPoint();

    // Actions
    if (!runActions) {
        return true;
    }

    lv_distance = (MinF(DistanceBetweenPoints(UnitGetPosition(lv_caster), lv_target), 12.0) + 2.0);
    lv_missiletarget = PointWithOffsetPolar(UnitGetPosition(lv_caster), lv_distance, AngleBetweenPoints(UnitGetPosition(lv_caster), lv_target));
    if ((TechTreeUpgradeCount(lv_owner, "WarpHeroDoubleganger", c_techCountQueuedOrBetter) > 0)) {
        lv_grp = UnitGetTrackedUnitGroup(lv_caster, "WarpHeroDecoyTracker");
        while ((lv_j < UnitGroupCount(lv_grp, c_unitCountAll))) {
            lv_j += 1;
            if ((UnitGetPropertyFixed(UnitGroupUnit(lv_grp, lv_j), c_unitPropEnergy, c_unitPropCurrent) >= 35.0) && (UnitIsAlive(UnitGroupUnit(lv_grp, lv_j)) == true)) {
                UnitSetPropertyFixed(UnitGroupUnit(lv_grp, lv_j), c_unitPropEnergy, (UnitGetPropertyFixed(UnitGroupUnit(lv_grp, lv_j), c_unitPropEnergy, c_unitPropCurrent) - 35.0));
            }
            else {
                UnitGroupRemove(lv_grp, UnitGroupUnit(lv_grp, lv_j));
                lv_j -= 1;
            }
        }
    }

    while ((lv_i < (2 + TechTreeUpgradeCount(lv_owner, "WarpHeroMultitask", c_techCountQueuedOrBetter))) && (UnitIsAlive(lv_caster) == true)) {
        lv_i += 1;
        lv_j = 0;
        if ((lv_i == 1)) {
            UnitCreateEffectPoint(lv_caster, "WarpHeroTurretAimStart", lv_missiletarget);
            gf_SkillMultishot(lv_caster, lv_caster, lv_owner, lv_missiletarget);
            autoA1EF4423_n = TechTreeUpgradeCount(lv_owner, "WarpHeroFocus", c_techCountQueuedOrBetter);
            for (autoA1EF4423_i = 1; autoA1EF4423_i <= autoA1EF4423_n; autoA1EF4423_i += 1) {
                lv_delay += 0.25;
                gf_SkillMultishotTalent(lv_delay, lv_caster, lv_caster, lv_owner, lv_missiletarget);
            }
            if ((TechTreeUpgradeCount(lv_owner, "WarpHeroDoubleganger", c_techCountQueuedOrBetter) > 0)) {
                while ((lv_j < UnitGroupCount(lv_grp, c_unitCountAll))) {
                    lv_j += 1;
                    if ((UnitIsAlive(UnitGroupUnit(lv_grp, lv_j)) == true)) {
                        lv_distance = (MinF(DistanceBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_target), 12.0) + 2.0);
                        lv_missiletarget = PointWithOffsetPolar(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_distance, AngleBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_target));
                        UnitCreateEffectPoint(UnitGroupUnit(lv_grp, lv_j), "WarpHeroTurretAimStart", lv_missiletarget);
                        gf_SkillMultishot(lv_caster, UnitGroupUnit(lv_grp, lv_j), lv_owner, lv_missiletarget);
                        lv_delay = 0.0;
                        auto41A4407D_n = TechTreeUpgradeCount(lv_owner, "WarpHeroFocus", c_techCountQueuedOrBetter);
                        for (auto41A4407D_i = 1; auto41A4407D_i <= auto41A4407D_n; auto41A4407D_i += 1) {
                            lv_delay += 0.25;
                            gf_SkillMultishotTalent(lv_delay, lv_caster, UnitGroupUnit(lv_grp, lv_j), lv_owner, lv_missiletarget);
                        }
                    }
                    else {
                        UnitGroupRemove(lv_grp, UnitGroupUnit(lv_grp, lv_j));
                        lv_j -= 1;
                    }
                }
            }

        }
        else {
            lv_distance = (MinF(DistanceBetweenPoints(UnitGetPosition(lv_caster), lv_target), 12.0) + 2.0);
            lv_missiletarget = PointWithOffsetPolar(UnitGetPosition(lv_caster), lv_distance, AngleBetweenPoints(UnitGetPosition(lv_caster), lv_target));
            gf_SkillMultishot(lv_caster, lv_caster, lv_owner, PointWithOffsetPolar(lv_missiletarget, (lv_i-1), (90.0 + AngleBetweenPoints(UnitGetPosition(lv_caster), lv_missiletarget))));
            gf_SkillMultishot(lv_caster, lv_caster, lv_owner, PointWithOffsetPolar(lv_missiletarget, (lv_i-1), (270.0 + AngleBetweenPoints(UnitGetPosition(lv_caster), lv_missiletarget))));
            if ((TechTreeUpgradeCount(lv_owner, "WarpHeroDoubleganger", c_techCountQueuedOrBetter) > 0)) {
                while ((lv_j < UnitGroupCount(lv_grp, c_unitCountAll))) {
                    lv_j += 1;
                    if ((UnitIsAlive(UnitGroupUnit(lv_grp, lv_j)) == true)) {
                        lv_distance = (MinF(DistanceBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_target), 12.0) + 2.0);
                        lv_missiletarget = PointWithOffsetPolar(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_distance, AngleBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_target));
                        gf_SkillMultishot(lv_caster, UnitGroupUnit(lv_grp, lv_j), lv_owner, PointWithOffsetPolar(lv_missiletarget, (lv_i-1), (90.0 + AngleBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_missiletarget))));
                        gf_SkillMultishot(lv_caster, UnitGroupUnit(lv_grp, lv_j), lv_owner, PointWithOffsetPolar(lv_missiletarget, ((lv_i)*-1)+1, (90.0 + AngleBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_grp, lv_j)), lv_missiletarget))));
                    }
                    else {
                        UnitGroupRemove(lv_grp, UnitGroupUnit(lv_grp, lv_j));
                        lv_j -= 1;
                    }
                }
            }

        }
    }
    return true;
}

