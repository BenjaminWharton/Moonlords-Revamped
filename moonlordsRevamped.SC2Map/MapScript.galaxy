    lv_objective = c_invalidObjectiveId;
    lv_ping1 = c_invalidPingId;
    lv_defenders = UnitGroupEmpty();
    lv_targetdrones = UnitGroupEmpty();
    lv_defenderc = PowI(2.0, gv_difficulty+1);
