int gf_getbossxp (unit lp_boss) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitBehaviorCount(lp_boss, "NormalBoss") > 0)) {
        return (1000 + (300 * gv_stage));
    }
    else if ((UnitBehaviorCount(lp_boss, "HardBoss") > 0)) {
        return (3000 + (500 * gv_stage));
    }
    else if ((UnitBehaviorCount(lp_boss, "InsaneBoss") > 0)) {
        return (8000 + (700 * gv_stage));
    }
    else if ((UnitBehaviorCount(lp_boss, "LegendaryBoss") > 0)) {
        return (20000 + (1000 * gv_stage));
    }
    return (0 + (250 * gv_stage));
}

