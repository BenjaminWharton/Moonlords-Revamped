//--------------------------------------------------------------------------------------------------
// Trigger: ShowTalents
//--------------------------------------------------------------------------------------------------
bool gt_ShowTalents_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_ScreenButton(39) == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_talentDialogs[lv_player].lv_dialog != c_invalidDialogId)) {
        if ((DialogIsVisible(gv_talentDialogs[lv_player].lv_dialog, lv_player) == true)) {
            DialogSetVisible(gv_talentDialogs[lv_player].lv_dialog, PlayerGroupSingle(lv_player), false);
        }
        else {
            gf_DialogHideAll(lv_player);
            libNtve_gf_SetDialogItemText(gv_talents[8][0][lv_player].lv_dialogItem, gf_GetTalentPointsTextForPlayer(lv_player), PlayerGroupSingle(lv_player));
            DialogSetVisible(gv_talentDialogs[lv_player].lv_dialog, PlayerGroupSingle(lv_player), true);
        }
    }

    return true;
}

