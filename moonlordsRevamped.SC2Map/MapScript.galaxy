            UnitIssueOrder(lv_banshee, OrderTargetingUnit(AbilityCommand("attack", 0), lp_target), c_orderQueueReplace);
        }
        Wait(0.125, c_timeGame);
    }
    UnitKill(lv_banshee);
    return true;
}

