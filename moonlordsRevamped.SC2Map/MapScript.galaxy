bool auto_gf_rewardtimer_TriggerFunc (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;
    int[5] lv_timers;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    while(true){
    lv_i=0;
    Wait(5.0, c_timeGame);
    while(lv_i<5){
    lv_timers[lv_i]+=5;
    if(lv_timers[lv_i]>=300){
    lv_timers[lv_i]=0;
