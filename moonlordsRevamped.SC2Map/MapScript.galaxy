//--------------------------------------------------------------------------------------------------
// Trigger: TeleportDialogOpen
//--------------------------------------------------------------------------------------------------
bool gt_TeleportDialogOpen_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_ScreenButton(gv_sB_TELEPORT) == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_mode == 1)) {
        if ((gv_challengemodescout != null)) {
            UnitIssueOrder(gv_hero[EventPlayer()], Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            UnitSetPosition(gv_hero[EventPlayer()], UnitGetPosition(gv_challengemodescout), false);
            CameraPan(EventPlayer(), UnitGetPosition(gv_hero[EventPlayer()]), 0.0, -1, 10, false);
        }

    }
    else {
        if ((DialogIsVisible(gv_teleportdialog, EventPlayer()) == true)) {
            DialogSetVisible(gv_teleportdialog, PlayerGroupSingle(EventPlayer()), false);
        }
        else {
            gf_DialogHideAll(EventPlayer());
            DialogSetVisible(gv_teleportdialog, PlayerGroupSingle(EventPlayer()), true);
        }
    }
    return true;
}

