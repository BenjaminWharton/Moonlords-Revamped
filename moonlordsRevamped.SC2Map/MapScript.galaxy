    lv_pg = PlayerGroupSingle(UnitGetOwner(lp_hero));

    // Implementation
    DialogControlSetVisible(libNtve_gf_ScreenButton(gv_sB_TELEPORT), lv_pg, true);
    while ((UnitIsAlive(lp_hero) == true)) {
        if (((UnitGroupCount(UnitGroup("Pylon", gv_aLLIEDPLAYER, RegionCircle(UnitGetPosition(lp_hero), 6.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) >= 1) || (gv_pylondownteleport == true))) {
