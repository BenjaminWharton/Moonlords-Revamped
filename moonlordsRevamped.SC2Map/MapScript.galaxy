    gt_HeroKill = TriggerCreate("gt_HeroKill_Func");
    TriggerAddEventUnitDied(gt_HeroKill, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: AllyKill
//--------------------------------------------------------------------------------------------------
bool gt_AllyKill_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_eNEMYPLAYER))) {
            return false;
        }

        if (!((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_aLLIEDPLAYER))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetType(libNtve_gf_KillingUnit()) != "Pylon") && (UnitGetType(libNtve_gf_KillingUnit()) != "PhotonCannon") && (gv_difficulty > 1)) {
        gv_acmProtossKills += 1;
        gf_achievementPossiblyGainedTeam(65, gv_acmProtossKills);
    }

    if ((gv_stage >= 11) && (UnitGetType(EventUnit()) == "Hive")) {
        gf_achievements0killaward(42);
    }

    return true;
}

