    gf_gainxp(150+(250*(gv_stage-1)));
    lv_i = 0;
    while ((lv_i < 4)) {
        lv_i += 1;
        gf_rewardgainpoints(lv_i, 1, FixedToInt(gv_difficulty));
    }
