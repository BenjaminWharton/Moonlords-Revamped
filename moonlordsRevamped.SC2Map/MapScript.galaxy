bool gt_Incapacitation_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_mode == 0)) {
        if ((UnitHasBehavior2(EventUnit(), "IncapacitatedDemolisher") == true)) {
            libNtve_gf_ShowHideUnit(EventUnit(), false);
            UnitSetPosition(EventUnit(), Point(242.3, 11.0), false);
        }
        else {
            libNtve_gf_ShowHideUnit(EventUnit(), true);
            UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("Teleport", 0), RegionRandomPoint(RegionCircle(gv_protossBase, 3.0))), c_orderQueueReplace);
        }
    }
    else {
        if ((UnitHasBehavior2(EventUnit(), "IncapacitatedDemolisher") == true)) {
            libNtve_gf_ShowHideUnit(EventUnit(), false);
            UnitSetPosition(EventUnit(), Point(59.0, 46.0), false);
        }
        else {
            libNtve_gf_ShowHideUnit(EventUnit(), true);
        }
    }
    return true;
}

