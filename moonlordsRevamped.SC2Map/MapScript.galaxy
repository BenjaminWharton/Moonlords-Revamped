    DialogControlSetFullDialog(DialogControlLastCreated(), PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeHorizontalBorder, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_battlenet_glues_pageassets_dialog_nobg.dds", PlayerGroupAll());
    DialogSetVisible(DialogLastCreated(), PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemLabel(DialogLastCreated(), 500, 75, c_anchorTop, 0, 37, StringToText(""), ColorWithAlpha(0,0,0,0), false, 2.0);
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "MLHeaderLarge", PlayerGroupAll());
    gv_talents[8][0][lp_player].lv_dialogItem = DialogControlLastCreated();
}

void gf_CreateTalent (int lp_row, int lp_column, int lp_player, text lp_name, text lp_tooltip, string lp_upgrade, int lp_req) {
    // Variable Declarations
    text lv_talentName;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_talentName = gf_GetTalentName(lp_name, lp_upgrade, lp_player);

    // Implementation
    gv_talents[lp_row][lp_column][lp_player].lv_upgrade = lp_upgrade;
    gv_talents[lp_row][lp_column][lp_player].lv_name = lp_name;
    gv_talents[lp_row][lp_column][lp_player].lv_tooltip = lp_tooltip;
    gv_talents[lp_row][lp_column][lp_player].lv_req = lp_req;
    libNtve_gf_CreateDialogItemButton(gv_talentDialogs[lp_player].lv_dialog, 225, 50, c_anchorTopLeft, (35 + (lp_column * 225)), (100 + (lp_row * 50)), gf_GetTalentTooltip(gv_talents[lp_row][lp_column][lp_player]), lv_talentName, "");
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "MLTalentName", PlayerGroupAll());
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeEndCap, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_battlenet_glue_bluedropdownbuttonsmall_normalpressed.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage2(DialogControlLastCreated(), "Assets\\Textures\\ui_battlenet_glue_bluedropdownbuttonsmall_normaloverpressedover.dds", PlayerGroupAll());
    gv_talents[lp_row][lp_column][lp_player].lv_dialogItem = DialogControlLastCreated();
}

void gf_CreateTalentWithReqInc (int lp_row, int lp_column, int lp_player, text lp_name, text lp_tooltip, string lp_upgrade, int lp_req, int lp_reqIncrease) {
    // Variable Declarations
    text lv_talentName;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_talentName = gf_GetTalentName(lp_name, lp_upgrade, lp_player);

    // Implementation
    gv_talents[lp_row][lp_column][lp_player].lv_reqIncrease = lp_reqIncrease;
    gf_CreateTalent(lp_row, lp_column, lp_player, lp_name, lp_tooltip, lp_upgrade, lp_req);
}

void gf_TalentPressedGeneric (int lp_row, int lp_column, int lp_player) {
    // Variable Declarations
    string lv_upgrade;
    int lv_upgradeLevel;
    int lv_upgradeMax;
    int lv_dialogItem;
    int lv_req;
    text lv_name;
    playergroup lv_pg;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_upgrade = gv_talents[lp_row][lp_column][lp_player].lv_upgrade;
    lv_upgradeLevel = TechTreeUpgradeCount(lp_player, gv_talents[lp_row][lp_column][lp_player].lv_upgrade, c_techCountCompleteOnly);
    lv_upgradeMax = CatalogFieldValueGetAsInt(c_gameCatalogUpgrade, lv_upgrade, "MaxLevel", lp_player);
    lv_dialogItem = gv_talents[lp_row][lp_column][lp_player].lv_dialogItem;
    lv_req = gv_talents[lp_row][lp_column][lp_player].lv_req;
    lv_name = gv_talents[lp_row][lp_column][lp_player].lv_name;
    lv_pg = PlayerGroupSingle(lp_player);

    // Implementation
    if ((gf_Currentlevel() >= lv_req) && (lv_upgradeLevel < lv_upgradeMax)) {
        gv_naturalTalent = false;
        TechTreeUpgradeAddLevel(lp_player, lv_upgrade, 1);
        libNtve_gf_SetDialogItemText(lv_dialogItem, gf_GetTalentName(lv_name, lv_upgrade, lp_player), lv_pg);
        gv_talentpointsavailable[lp_player] -= 1;
        gv_talents[lp_row][lp_column][lp_player].lv_req = (gv_talents[lp_row][lp_column][lp_player].lv_req + gv_talents[lp_row][lp_column][lp_player].lv_reqIncrease);
        if ((TechTreeUpgradeCount(lp_player, lv_upgrade, c_techCountQueuedOrBetter) == lv_upgradeMax)) {
            DialogControlSetEnabled(gv_talents[lp_row][lp_column][lp_player].lv_dialogItem, PlayerGroupSingle(lp_player), false);
        }

    }
    libNtve_gf_SetDialogItemText(gv_talents[8][0][lp_player].lv_dialogItem, gf_GetTalentPointsTextForPlayer(lp_player), lv_pg);
    libNtve_gf_SetDialogItemText(gv_resourceLabelTalents, IntToText(gv_talentpointsavailable[lp_player]), lv_pg);
}

trigger auto_gf_initdisplaytalentsetcasMinerals_Trigger = null;

void gf_initdisplaytalentsetcasMinerals () {
    if (auto_gf_initdisplaytalentsetcasMinerals_Trigger == null) {
        auto_gf_initdisplaytalentsetcasMinerals_Trigger = TriggerCreate("auto_gf_initdisplaytalentsetcasMinerals_TriggerFunc");
    }

    TriggerExecute(auto_gf_initdisplaytalentsetcasMinerals_Trigger, false, false);
}

bool auto_gf_initdisplaytalentsetcasMinerals_TriggerFunc (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    while(true){
    lv_i = 0;
    while ((lv_i < gv_pLAYERCOUNT)) {
        lv_i += 1;
        if ((PlayerStatus(lv_i) == c_playerStatusActive)) {
            PlayerModifyPropertyInt(lv_i, c_playerPropMinerals, c_playerPropOperSetTo, gv_talentpointsavailable[lv_i]);
            PlayerModifyPropertyInt(lv_i, c_playerPropVespene, c_playerPropOperSetTo, gv_rewardUnspend[lv_i]);
            PlayerModifyPropertyInt(lv_i, c_playerPropSuppliesMade, c_playerPropOperSetTo, gv_upgradesAvailable);
            libNtve_gf_SetDialogItemText(gv_upgradesLabel, gf_GetUpgradePointsText(), PlayerGroupAll());
        }
        else {
            PlayerModifyPropertyInt(lv_i, c_playerPropMinerals, c_playerPropOperSetTo, 0);
            PlayerModifyPropertyInt(lv_i, c_playerPropVespene, c_playerPropOperSetTo, 0);
            PlayerModifyPropertyInt(lv_i, c_playerPropSuppliesUsed, c_playerPropOperSetTo, 0);
        }
    }
    Wait(1.0, c_timeGame);
    }
    return true;
}

