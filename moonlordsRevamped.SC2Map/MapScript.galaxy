// Trigger: PylonDeath
//--------------------------------------------------------------------------------------------------
bool gt_PylonDeath_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int autoB9597FD2_val;

    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Pylon"))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == gv_aLLIEDPLAYER))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (((gv_mode == 1) || (gv_stage < 2))) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/2E0C3845"));
        GameOver(1, c_gameOverDefeat, true, true);
        GameOver(2, c_gameOverDefeat, true, true);
        GameOver(3, c_gameOverDefeat, true, true);
        GameOver(4, c_gameOverDefeat, true, true);
    }
    else {
        if (((gv_stage < 8) || (gv_stage > 9))) {
            gv_stage -= 1;
        }
        else {
            gv_stage = 6;
        }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (StringExternal("Param/Value/5EDDD77F") + IntToText(gv_stage) + StringExternal("Param/Value/FB5F005D")));
        gv_zpylonslostthisgame += 1;
        autoB9597FD2_val = gv_stage;
        if (autoB9597FD2_val == 1) {
            TriggerExecute(gt_activatebase1again, true, false);
        }
        else if (autoB9597FD2_val == 2) {
            TriggerExecute(gt_activatebase2, true, false);
        }
        else if (autoB9597FD2_val == 3) {
            TriggerExecute(gt_activatebase3, true, false);
        }
        else if (autoB9597FD2_val == 4) {
            TriggerExecute(gt_activatebase4, true, false);
        }
        else if (autoB9597FD2_val == 5) {
            TriggerExecute(gt_activatebase5, true, false);
        }
        else if (autoB9597FD2_val == 6) {
            TriggerExecute(gt_activatebase6, true, false);
        }
        else if (autoB9597FD2_val == 7) {
            TriggerExecute(gt_activatebase7, true, false);
        }
        else if (autoB9597FD2_val == 8) {
            TriggerExecute(gt_activateStage8, true, false);
        }
        else if (autoB9597FD2_val == 9) {
            TriggerExecute(gt_activateStage9, true, false);
        }
        else if (autoB9597FD2_val == 10) {
            TriggerExecute(gt_activateStage10, true, false);
        }
        else if (autoB9597FD2_val == 11) {
            TriggerExecute(gt_activateStage11, true, false);
        }
        else {
        }
        UnitSetPosition(gv_demolisher, gv_protossBase, false);
        gv_pylondownteleport = true;
        Wait(20.0, c_timeGame);
        gv_pylondownteleport = false;
    }
    return true;
}

