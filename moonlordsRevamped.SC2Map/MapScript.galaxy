// Trigger: UpgradeDialogButtonPressed
//--------------------------------------------------------------------------------------------------
bool gt_UpgradeDialogButtonPressed_Func (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_condition;
    int lv_row;
    int lv_column;
    int lv_i;
    int lv_j;

    // Automatic Variable Declarations
    const int autoFB54777B_ae = 6;
    const int autoFB54777B_ai = 1;
    const int auto5374E72E_ae = 1;
    const int auto5374E72E_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gv_upgradesAvailable >= 1))) {
            return false;
        }

        if (!((DialogControlGetDialog(EventDialogControl()) == gv_upgradeDialog))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_i = 0;
    for ( ; ( (autoFB54777B_ai >= 0 && lv_i <= autoFB54777B_ae) || (autoFB54777B_ai < 0 && lv_i >= autoFB54777B_ae) ) ; lv_i += autoFB54777B_ai ) {
        lv_j = 0;
        for ( ; ( (auto5374E72E_ai >= 0 && lv_j <= auto5374E72E_ae) || (auto5374E72E_ai < 0 && lv_j >= auto5374E72E_ae) ) ; lv_j += auto5374E72E_ai ) {
            if ((EventDialogControl() == gv_upgrades[lv_i][lv_j].lv_dialogItem)) {
                lv_row = lv_i;
                lv_column = lv_j;
                lv_condition = true;
            }

        }
    }
    if ((lv_condition == false)) {
        return true;
    }

    gf_UpgradePressed(lv_row, lv_column);
    return true;
}

