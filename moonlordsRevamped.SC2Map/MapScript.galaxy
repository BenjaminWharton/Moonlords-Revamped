//--------------------------------------------------------------------------------------------------
// Trigger: Player Leaves
//--------------------------------------------------------------------------------------------------
bool gt_PlayerLeaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = EventPlayer();

    // Actions
    if (!runActions) {
        return true;
    }

    gf_UndoVote(lv_player, true);
    if ((PlayerStatus(lv_player) == c_playerStatusLeft) && (gv_hero[lv_player] != null)) {
        UnitRemove(gv_hero[lv_player]);
        gv_hero[lv_player] = null;
    }

    if ((gv_demolisher == null) && (PlayerGroupCount(PlayerGroupActive()) == 1)) {
        if ((gv_mode == 0) && (gv_zmaxstage > 1)) {
            UnitCreate(1, "Demolisher", 0, gv_aLLIEDPLAYER, UnitGetPosition(gf_getpylonofprevstage()), 270.0);
            gv_demolisher = UnitLastCreated();
            gf_ProtossAttackAI(libNtve_gf_ConvertUnitToUnitGroup(gv_demolisher));
        }
        else {
            if ((gv_challengeStage > 3)) {
                UnitCreate(1, "Demolisher", 0, gv_aLLIEDPLAYER, Point(59.0, 46.0), 270.0);
                gv_demolisher = UnitLastCreated();
                gf_challengemodearmyAI(UnitGroupUnit(UnitGroup("Pylon", gv_aLLIEDPLAYER, RegionCircle(Point(59.0, 47.0), 3.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), 1), libNtve_gf_ConvertUnitToUnitGroup(gv_demolisher));
            }

        }
    }

    return true;
}

