//--------------------------------------------------------------------------------------------------
// Trigger: pickhero
//--------------------------------------------------------------------------------------------------
bool gt_pickhero_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_spawnpoint;
    int lv_player;
    bool lv_condition;
    int lv_heroNum;
    int lv_winDifficulty;
    int lv_achievements;

    // Automatic Variable Declarations
    const int auto7A5A0F6A_ae = gv_hEROCOUNT;
    int auto7A5A0F6A_var;

    // Variable Initialization
    lv_spawnpoint = Point(59.0, 47.0);
    lv_player = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((gv_hero[lv_player] == null))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto7A5A0F6A_var = 0;
    for ( ; auto7A5A0F6A_var <= auto7A5A0F6A_ae; auto7A5A0F6A_var += 1 ) {
        if ((EventDialogControl() == gv_heroPickButtons[auto7A5A0F6A_var].lv_dialogItem)) {
            lv_heroNum = auto7A5A0F6A_var;
            lv_winDifficulty = gv_heroPickButtons[lv_heroNum].lv_winDifficulty;
            lv_achievements = gv_heroPickButtons[lv_heroNum].lv_achievements;
            lv_condition = true;
        }

    }
    if ((lv_condition == false)) {
        return true;
    }

    if ((PlayerHandle(lv_player) != "")) {
        if ((gf_HeroUnlockReq(lv_winDifficulty, lv_achievements, lv_player) == false)) {
            UIDisplayMessage(PlayerGroupSingle(lv_player), c_messageAreaSubtitle, StringExternal("Param/Value/78C7A987"));
            return true;
        }

    }

    DialogSetVisible(gv_heroPickDialog, PlayerGroupSingle(lv_player), false);
    if ((gv_mode == 0)) {
        lv_spawnpoint = Point(239.0, 8.0);
    }

    if ((lv_heroNum == ge_Heroes_Fire)) {
        UnitCreate(1, "FireHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogFire(lv_player);
        gf_bankaddtoint(gv_zbanks[lv_player], "firehero", "statscounter", 1);
    }

    if ((lv_heroNum == ge_Heroes_Lightning)) {
        UnitCreate(1, "LightningHero", 0, lv_player, lv_spawnpoint, 270.0);
        UnitSetCustomValue(UnitLastCreated(), 0, 4.0);
        UnitSetCustomValue(UnitLastCreated(), 5, 2.0);
        UnitSetCustomValue(UnitLastCreated(), 10, 1.8);
        UnitSetCustomValue(UnitLastCreated(), 11, 0.5);
        UnitSetCustomValue(UnitLastCreated(), 20, 3.0);
        UnitSetCustomValue(UnitLastCreated(), 21, 10.0);
        gf_StaticArmor(UnitLastCreated());
        gf_TalentDialogLightning(lv_player);
        gf_bankaddtoint(gv_zbanks[lv_player], "lightninghero", "statscounter", 1);
    }

    if ((lv_heroNum == ge_Heroes_Poison)) {
        UnitCreate(1, "PoisonHero", 0, lv_player, lv_spawnpoint, 270.0);
        UnitSetCustomValue(UnitLastCreated(), 0, 1.5);
        UnitSetCustomValue(UnitLastCreated(), 1, 3.0);
        UnitSetCustomValue(UnitLastCreated(), 2, 10.0);
        UnitSetCustomValue(UnitLastCreated(), 5, 0.5);
        UnitSetCustomValue(UnitLastCreated(), 6, 2.0);
        UnitSetCustomValue(UnitLastCreated(), 10, 1.0);
        UnitSetCustomValue(UnitLastCreated(), 11, 1.0);
        UnitSetCustomValue(UnitLastCreated(), 12, 1.0);
        UnitSetCustomValue(UnitLastCreated(), 15, 1.0);
        UnitSetCustomValue(UnitLastCreated(), 20, 3.0);
        gf_poisonarmorstacks(UnitLastCreated());
        gf_TalentDialogPoison(lv_player);
        gf_bankaddtoint(gv_zbanks[lv_player], "poisonhero", "statscounter", 1);
    }

    if ((lv_heroNum == ge_Heroes_Shadow)) {
        UnitCreate(1, "ShadowHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_Shadowwallofdarkness(UnitLastCreated());
        gf_bankaddtoint(gv_zbanks[lv_player], "shadowhero", "statscounter", 1);
        HelpPanelAddTip(PlayerGroupSingle(lv_player), libNtve_gf_FormatTipTitle(StringExternal("Param/Value/74BBCB54"), libNtve_ge_TipType_NormalTip), StringExternal("Param/Value/73885120"), StringExternal("Param/Value/ABFDD773"), "Assets\\WallOfDarknessEx3.dds");
        gf_TalentDialogShadow(lv_player);
        if ((gf_bankgetint(gv_zbanks[lv_player], "shadowenergy", "tip") == 1)) {
            TipAlertPanelClear(PlayerGroupSingle(lv_player));
        }
        else {
            gf_bankaddtoint(gv_zbanks[lv_player], "shadowenergy", "tip", 1);
        }
    }

    if ((lv_heroNum == ge_Heroes_Warp)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "warphero", "statscounter", 1);
        UnitCreate(1, "WarpHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogWarp(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Particle)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "particlehero", "statscounter", 1);
        UnitCreate(1, "ParticleHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogParticle(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Twilight)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "twilighthero", "statscounter", 1);
        UnitCreate(1, "TwilightHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogTwilight(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Time)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "timehero", "statscounter", 1);
        UnitCreate(1, "TimeHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogTime(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Water)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "waterhero", "statscounter", 1);
        UnitCreate(1, "WaterHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogWater(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Earth)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "earthhero", "statscounter", 1);
        UnitCreate(1, "EarthHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogEarth(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Air)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "airhero", "statscounter", 1);
        UnitCreate(1, "AirHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogAir(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Gravity)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "gravityhero", "statscounter", 1);
        UnitCreate(1, "GravityHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogGravity(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Gateway)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "gatewayhero", "statscounter", 1);
        UnitCreate(1, "GatewayHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogGateway(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Nature)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "naturehero", "statscounter", 1);
        UnitCreate(1, "NatureHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogNature(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Elemental)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "elementalhero", "statscounter", 1);
        UnitCreate(1, "ElementalHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogElemental(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Illusion)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "illusionhero", "statscounter", 1);
        UnitCreate(1, "IllusionHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogIllusion(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Luck)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "luckhero", "statscounter", 1);
        UnitCreate(1, "LuckHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_LuckOrbs(UnitLastCreated(), "OrbOfLuck", 4, lv_player, 1.25, 3.0, 1.25);
        gf_TalentDialogLuck(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Probe)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "probehero", "statscounter", 1);
        UnitCreate(1, "ProbeHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogProbe(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Blade)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "bladehero", "statscounter", 1);
        UnitCreate(1, "BladeHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogBlade(lv_player);
    }

    if ((lv_heroNum == ge_Heroes_Beam)) {
        gf_bankaddtoint(gv_zbanks[lv_player], "beamhero", "statscounter", 1);
        UnitCreate(1, "BeamHero", 0, lv_player, lv_spawnpoint, 270.0);
        gf_TalentDialogBeam(lv_player);
    }

    UnitBehaviorAdd(UnitLastCreated(), "CoopInitdelay", UnitLastCreated(), 1);
    if ((gv_mode == 0)) {
        gf_TeleportHideShow(UnitLastCreated());
    }

    UnitBehaviorAdd(UnitLastCreated(), "RestlessPassive", UnitLastCreated(), 1);
    if ((gv_difficulty < 2.0)) {
        UnitBehaviorAdd(UnitLastCreated(), "Easy", UnitLastCreated(), 1);
    }

    if ((gv_difficulty == 2.0)) {
        UnitBehaviorAdd(UnitLastCreated(), "Normal", UnitLastCreated(), 1);
    }

    if ((gv_difficulty == 3.0)) {
        UnitBehaviorAdd(UnitLastCreated(), "Hard", UnitLastCreated(), 1);
    }

    if ((gv_difficulty == 4.0)) {
        UnitBehaviorAdd(UnitLastCreated(), "Insane", UnitLastCreated(), 1);
    }

    if ((gv_difficulty == 5.0)) {
        if ((gv_hardcore == true)) {
            if ((gv_playercount == 1)) {
                UnitBehaviorAdd(UnitLastCreated(), "Ironcore", UnitLastCreated(), 1);
            }
            else {
                UnitBehaviorAdd(UnitLastCreated(), "Hardcore", UnitLastCreated(), 1);
            }
        }
        else {
            UnitBehaviorAdd(UnitLastCreated(), "Legendary", UnitLastCreated(), 1);
        }
    }

    gv_hero[lv_player] = UnitLastCreated();
    UnitControlGroupAddUnit(EventPlayer(), 1, gv_hero[lv_player]);
    gf_disguiseunit(UnitLastCreated(), lv_player);
    gf_rewardaddall(lv_player, false);
    return true;
}

