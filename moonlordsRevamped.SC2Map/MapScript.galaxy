                UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), gv_protossBase), c_orderQueueReplace);
                if ((lv_nextchampion < 1)) {
                    if ((gv_champion == 0)) {
