    libNtve_gf_SetBehaviorCount(UnitLastCreated(), "DifficultyBuff", UnitLastCreated(), ((FixedToInt((gv_difficulty - 1.0)) * 4) + (gv_zmaxstage * FixedToInt((gv_difficulty / 1.0)))));
