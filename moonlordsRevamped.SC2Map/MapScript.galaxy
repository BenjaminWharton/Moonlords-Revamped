                    UnitBehaviorAdd(lv_u1, "ZergSpawnerInactive", lv_u1, 1);
                }

            }

        }
        Wait(1.0, c_timeGame);
    }
    gf_gainxp(lp_xpondestruction);
    gf_GainReward(lp_reward);
    if ((lp_spawnUnitKillcount > 0)) {
        UnitCreate(lp_spawnUnitKillcount, lp_spawnUnitKill, c_unitCreateIgnorePlacement | c_unitCreateIgnoreBirth, 6, lp_spawnpos, 90.0);
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), gv_protossBase), c_orderQueueReplace);
