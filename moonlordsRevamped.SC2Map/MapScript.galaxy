void gf_TalentPressedNature (int lp_row, int lp_column, int lp_player) {
    // Variable Declarations
    string lv_upgrade;
    int lv_upgradeLevel;
    int lv_upgradeMax;
    int lv_req;
    text lv_name;
    playergroup lv_pg;

    // Automatic Variable Declarations
    int auto147C3982_n;
    int auto147C3982_i;

    // Variable Initialization
    lv_upgrade = gv_talents[lp_row][lp_column][lp_player].lv_upgrade;
    lv_upgradeLevel = TechTreeUpgradeCount(lp_player, gv_talents[lp_row][lp_column][lp_player].lv_upgrade, c_techCountCompleteOnly);
    lv_upgradeMax = CatalogFieldValueGetAsInt(c_gameCatalogUpgrade, lv_upgrade, "MaxLevel", lp_player);
    lv_req = gv_talents[lp_row][lp_column][lp_player].lv_req;
    lv_name = gv_talents[lp_row][lp_column][lp_player].lv_name;
    lv_pg = PlayerGroupSingle(lp_player);

    // Implementation
    if ((gf_Currentlevel() >= lv_req) && (lv_upgradeLevel < lv_upgradeMax)) {
        TechTreeUpgradeAddLevel(lp_player, lv_upgrade, 1);
        libNtve_gf_SetDialogItemText(EventDialogControl(), gf_GetTalentName(lv_name, lv_upgrade, lp_player), lv_pg);
        gv_talentpointsavailable[lp_player] -= 1;
        if ((lp_row == 5) && (lp_column == 2)) {
            auto147C3982_n = UnitBehaviorCount(gv_hero[lp_player], "ExpelComboCount");
            for (auto147C3982_i = 1; auto147C3982_i <= auto147C3982_n; auto147C3982_i += 1) {
                UnitCreateEffectUnit(gv_hero[lp_player], "NatureHeroExpelCostUpMP", gv_hero[lp_player]);
            }
        }

    }
    libNtve_gf_SetDialogItemText(gv_talents[8][0][lp_player].lv_dialogItem, gf_GetTalentPointsTextForPlayer(lp_player), lv_pg);
}

