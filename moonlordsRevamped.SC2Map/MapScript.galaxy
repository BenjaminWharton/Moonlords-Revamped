    gt_ShowTalents = TriggerCreate("gt_ShowTalents_Func");
    TriggerAddEventDialogControl(gt_ShowTalents, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: TalentButtonPressed
//--------------------------------------------------------------------------------------------------
bool gt_TalentButtonPressed_Func (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_condition;
    int lv_player;
    int lv_row;
    int lv_column;
    int lv_heroNum;
    int lv_i;
    int lv_j;

    // Automatic Variable Declarations
    const int auto4EE9A824_ae = gv_pLAYERCOUNT;
    int auto4EE9A824_var;
    int autoF99073C8_val;

    // Variable Initialization
    lv_player = EventPlayer();
    lv_row = -1;
    lv_column = -1;

    // Conditions
    if (testConds) {
        if (!((gv_talentpointsavailable[lv_player] >= 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto4EE9A824_var = 1;
    for ( ; auto4EE9A824_var <= auto4EE9A824_ae; auto4EE9A824_var += 1 ) {
        if ((DialogControlGetDialog(EventDialogControl()) == gv_talentDialogs[auto4EE9A824_var].lv_dialog)) {
            lv_condition = true;
            lv_heroNum = gv_talentDialogs[auto4EE9A824_var].lv_heroNum;
        }

    }
    if ((lv_condition == false)) {
        return true;
    }

    while ((lv_i < 10)) {
        lv_j = 0;
        while ((lv_j < 5)) {
            if ((EventDialogControl() == gv_talents[lv_i][lv_j][lv_player].lv_dialogItem)) {
                lv_row = lv_i;
                lv_column = lv_j;
                lv_i = 10;
                lv_j = 10;
            }

            lv_j += 1;
        }
        lv_i += 1;
    }
    if ((lv_row == -1)) {
        return true;
    }

    autoF99073C8_val = lv_heroNum;
    if (autoF99073C8_val == ge_Heroes_Fire) {
        gf_TalentPressedFire(lv_row, lv_column, lv_player);
    }
    else if (autoF99073C8_val == ge_Heroes_Lightning) {
        gf_TalentPressedLightning(lv_row, lv_column, lv_player);
    }
    else if (autoF99073C8_val == ge_Heroes_Poison) {
        gf_TalentPressedPoison(lv_row, lv_column, lv_player);
    }
    else if (autoF99073C8_val == ge_Heroes_Beam) {
        gf_TalentPressedBeam(lv_row, lv_column, lv_player);
    }
    else if (autoF99073C8_val == ge_Heroes_Nature) {
        gf_TalentPressedNature(lv_row, lv_column, lv_player);
    }
    else if (autoF99073C8_val == ge_Heroes_Blade) {
        gf_TalentPressedBlade(lv_row, lv_column, lv_player);
    }
    else if (autoF99073C8_val == ge_Heroes_Luck) {
        gf_TalentPressedLuck(lv_row, lv_column, lv_player);
    }
    else {
        gf_TalentPressedGeneric(lv_row, lv_column, lv_player);
    }
    return true;
}

