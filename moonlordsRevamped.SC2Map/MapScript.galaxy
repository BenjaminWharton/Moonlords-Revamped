    lv_point = lp_point;
    lv_targetspeed = (gv_difficulty*0.03125);
    lv_starttime = (gv_zgametime[3] + 180);

    // Implementation
    if ((lv_defenderc == 4)) {
        lv_defenderc = 8;
    }

    Wait(3.0, c_timeGame);
