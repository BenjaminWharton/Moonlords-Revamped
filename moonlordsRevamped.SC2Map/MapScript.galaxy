void gf_bankconvertoldachievementdata197 (bank lp_bank) {
    // Variable Declarations
    int lv_i;
    string lv_acm;
    int lv_temp;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_acm = "";

    // Implementation
    while ((lv_i < 48)) {
        lv_i += 1;
        if ((lv_i != 7) && (lv_i != 8)) {
            lv_temp = (gf_bankgetint(lp_bank, IntToString(lv_i), "acm") + (gf_bankgetint(lp_bank, IntToString(lv_i+1), "acm") * 8));
            BankKeyRemove(lp_bank, "acm", IntToString(lv_i));
            BankKeyRemove(lp_bank, "acm", IntToString(lv_i+1));
        }
        else {
            lv_temp = 0;
        }
        lv_acm = (lv_acm + gf_decto45(lv_temp));
        lv_i += 1;
    }
    BankValueSetFromString(lp_bank, "acm", "a", lv_acm);
    BankSave(lp_bank);
}

string gf_decto45 (int lp_num) {
    // Variable Declarations
    string lv__32string;

    // Automatic Variable Declarations
    // Variable Initialization
    lv__32string = "0123456789abcdefhijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";

    // Implementation
    return StringSub(lv__32string, lp_num+1, lp_num+1);
}

int gf__45todec (string lp__45num) {
    // Variable Declarations
    int lv_i;
    string lv__32string;

    // Automatic Variable Declarations
    // Variable Initialization
    lv__32string = "0123456789abcdefhijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";

    // Implementation
    while ((lv_i < 47)) {
        lv_i += 1;
        if ((lp__45num == StringSub(lv__32string, lv_i, lv_i))) {
            return lv_i-1;
        }

    }
    return 0;
}

int gf_split45to2 (int lp__45, int lp_achievement) {
    // Automatic Variable Declarations
    // Implementation
    if ((ModI(lp_achievement, 2) == 0)) {
        return (lp__45 / 8);
    }
    else {
        return lp__45%8;
    }
}

trigger auto_gf_Massacre_Trigger = null;
unit auto_gf_Massacre_lp_hero;

void gf_Massacre (unit lp_hero) {
    auto_gf_Massacre_lp_hero = lp_hero;

    if (auto_gf_Massacre_Trigger == null) {
        auto_gf_Massacre_Trigger = TriggerCreate("auto_gf_Massacre_TriggerFunc");
    }

    TriggerExecute(auto_gf_Massacre_Trigger, false, false);
}

bool auto_gf_Massacre_TriggerFunc (bool testConds, bool runActions) {
    unit lp_hero = auto_gf_Massacre_lp_hero;

    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = UnitGetOwner(lp_hero);

    // Implementation
    while (true) {
        if ((UnitBehaviorCount(lp_hero, "MassacreHelper") > 0)) {
            libNtve_gf_SetDialogItemText(gv_massacreLabel, (StringExternal("Param/Value/32E561E2") + IntToText(gv_massacrekills[lv_player])), PlayerGroupSingle(lv_player));
            libNtve_gf_SetDialogItemStyle(gv_massacreLabel, gf_MassacreStyle(lv_player, gv_massacrekills[lv_player]), PlayerGroupAll());
            if ((gv_massacrekills[lv_player] >= 50) && (DialogIsVisible(gv_massacreDialog, lv_player) == false)) {
                DialogSetVisible(gv_massacreDialog, PlayerGroupSingle(lv_player), true);
            }

        }
        else {
            if ((DialogIsVisible(gv_massacreDialog, lv_player) == true)) {
                DialogSetVisible(gv_massacreDialog, PlayerGroupSingle(lv_player), false);
                gf_MassacreReward(lv_player, gv_massacrekills[lv_player]);
            }

            gv_massacrekills[lv_player] = 0;
        }
        Wait(0.0625, c_timeGame);
    }
    return true;
}

void gf_MassacreReward (int lp_player, int lp_massacre) {
    // Variable Declarations
    int lv_massacrexp;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((PlayerStatus(lp_player) == c_playerStatusActive) && (lp_massacre >= 50)) {
        if ((lp_massacre >= 10000)) {
            lv_massacrexp = 318000;
        }
        else {
            lv_massacrexp = ((PowI(lp_massacre, 1.3) + 500) * 2);
        }
        UIDisplayMessage(PlayerGroupSingle(lp_player), c_messageAreaSubtitle, gf_MassacreText((StringExternal("Param/Value/884045DD") + IntToText(lp_massacre) + StringExternal("Param/Value/CE6EADD3") + IntToText(lv_massacrexp) + StringExternal("Param/Value/AB79C479")), lp_massacre));
        gf_gainxp(IntToFixed(lv_massacrexp));
        gf_ChronoWave(lp_player, lp_massacre);
        if ((PlayerStatus(lp_player) == c_playerStatusActive) && (gv_difficulty >= 3.0)) {
            while ((gf_achievementgetvalueofnextlevel(45, lp_player) <= lp_massacre)) {
                gf_achievementnew(lp_player, 45);
            }
            if ((lp_massacre > gf_bankgetint(gv_zbanks[lp_player], "m", "acm"))) {
                BankValueSetFromInt(gv_zbanks[lp_player], "acm", "m", lp_massacre);
            }

        }

    }

}

void gf_CreateMassacreDialog () {
    // Automatic Variable Declarations
    // Implementation
    DialogCreate(450, 50, c_anchorBottom, 0, 285, false);
    DialogSetImageVisible(DialogLastCreated(), false);
    gv_massacreDialog = DialogLastCreated();
    libNtve_gf_CreateDialogItemLabel(DialogLastCreated(), 450, 50, c_anchorTopLeft, 0, 0, StringToText(""), ColorWithAlpha(0,0,0,0), false, 2.0);
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "Massacre1", PlayerGroupAll());
    gv_massacreLabel = DialogControlLastCreated();
}

