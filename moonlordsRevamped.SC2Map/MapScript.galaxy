string gf_MassacreStyle (int lp_player, int lp_massacre) {
    // Variable Declarations
    int lv_massacre;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_massacre = lp_massacre;

    // Implementation
    if ((lv_massacre <= 250)) {
        return "Massacre1";
    }
    else if ((lv_massacre <= 500)) {
        return "Massacre2";
    }
    else if ((lv_massacre <= 1000)) {
        return "Massacre3";
    }
    else if ((lv_massacre <= 2000)) {
        return "Massacre4";
    }
    return "Massacre5";
}

