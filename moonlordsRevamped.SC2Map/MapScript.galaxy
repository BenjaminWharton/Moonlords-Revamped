    point lv_rpoint;
    int lv_scount;
    int lv_stimer;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    while (((lp_count - lv_seeded) > 0)) {
        lv_picked = false;
        lv_i = lv_seeded;
        lv_i -= lp_countbytype1;
        if ((lv_i < 0)) {
            if ((gv_champion == 1)) {
                lv_picked = true;
                lv_gtyp = "SpawningPool";
                lv_utyp = "HotSSwarmling";
                lv_scount = 1;
                lv_stimer = 12;
            }
            else {
                lv_picked = true;
                lv_gtyp = "SpawningPool";
                lv_utyp = "Zergling";
                lv_scount = 6;
                lv_stimer = 8;
            }
        }
        else {
            lv_i -= lp_countbytype2;
            if ((lv_i < 0)) {
                if ((gv_champion == 1)) {
                    lv_picked = true;
                    lv_gtyp = "BanelingNest";
                    lv_utyp = "HotSSplitterlingBig";
                    lv_scount = 1;
                    lv_stimer = 11;
                }
                else {
                    lv_picked = true;
                    lv_gtyp = "BanelingNest";
                    lv_utyp = "Baneling";
                    lv_scount = 4;
                    lv_stimer = 7;
                }
            }
            else {
                lv_i -= lp_countbytype3;
                if ((lv_i < 0)) {
                    if ((gv_champion == 1)) {
                        lv_picked = true;
