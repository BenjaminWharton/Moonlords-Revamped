    lv_unit = UnitGroupClosestToPoint(UnitGroup(lp_type, gv_eNEMYPLAYER, RegionCircle(lp_point, 1.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), lp_point);
