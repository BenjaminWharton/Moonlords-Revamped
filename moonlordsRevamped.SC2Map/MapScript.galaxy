void gf_TalentPressedBlade (int lp_row, int lp_column, int lp_player) {
    // Variable Declarations
    string lv_upgrade;
    int lv_upgradeLevel;
    int lv_upgradeMax;
    int lv_dialogItem;
    int lv_req;
    text lv_name;
    playergroup lv_pg;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_upgrade = gv_talents[lp_row][lp_column][lp_player].lv_upgrade;
    lv_upgradeLevel = TechTreeUpgradeCount(lp_player, gv_talents[lp_row][lp_column][lp_player].lv_upgrade, c_techCountCompleteOnly);
    lv_upgradeMax = CatalogFieldValueGetAsInt(c_gameCatalogUpgrade, lv_upgrade, "MaxLevel", lp_player);
    lv_dialogItem = gv_talents[lp_row][lp_column][lp_player].lv_dialogItem;
    lv_req = gv_talents[lp_row][lp_column][lp_player].lv_req;
    lv_name = gv_talents[lp_row][lp_column][lp_player].lv_name;
    lv_pg = PlayerGroupSingle(lp_player);

    // Implementation
    if ((gf_Currentlevel() >= lv_req) && (lv_upgradeLevel < lv_upgradeMax)) {
        gv_naturalTalent = false;
        TechTreeUpgradeAddLevel(lp_player, lv_upgrade, 1);
        libNtve_gf_SetDialogItemText(lv_dialogItem, gf_GetTalentName(lv_name, lv_upgrade, lp_player), lv_pg);
        gv_talentpointsavailable[lp_player] -= 1;
        gv_talents[lp_row][lp_column][lp_player].lv_req = (gv_talents[lp_row][lp_column][lp_player].lv_req + gv_talents[lp_row][lp_column][lp_player].lv_reqIncrease);
        if ((TechTreeUpgradeCount(lp_player, lv_upgrade, c_techCountQueuedOrBetter) == lv_upgradeMax)) {
            DialogControlSetEnabled(gv_talents[lp_row][lp_column][lp_player].lv_dialogItem, PlayerGroupSingle(lp_player), false);
        }

        if ((lp_row == 5) && (lp_column == 0)) {
