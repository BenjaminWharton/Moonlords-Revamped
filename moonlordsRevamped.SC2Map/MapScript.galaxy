void gf_AddShadowEnergy (bool lp_reset, int lp_owner, int lp_amount) {
    // Variable Declarations
    int lv_heron;
    fixed lv_amount;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_heron = lp_owner;
    lv_amount = IntToFixed(lp_amount);

    // Implementation
    if ((UnitIsAlive(gv_hero[lv_heron]) == true)) {
        gf_addenergy(gv_hero[lv_heron], (TechTreeUpgradeCount(lp_owner, "ShadowHeroShadowFeast", c_techCountQueuedOrBetter) * (lp_amount + 0.125)), false);
        gf_UnitAddCustomValue(gv_hero[lv_heron], lv_amount, 1);
        if ((UnitGetCustomValue(gv_hero[lv_heron], 1) >= 100.0)) {
            gf_UnitAddCustomValue(gv_hero[lv_heron], -100.0, 1);
            gf_AEShadowCrash(lp_owner);
        }

    }

    libNtve_gf_SetUpgradeLevelForPlayer(lp_owner, "ShadowEnergyChargeDummy", FixedToInt(UnitGetCustomValue(gv_hero[lv_heron], 1)));
}

void gf_AEShadowCrash (int lp_owner) {
    // Variable Declarations
    int lv_counter;
    unitgroup lv_targets;
    int lv_maxcount;
    unit lv_target;
    int lv_energy;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_targets = UnitGroup(null, 6, RegionCircle(UnitGetPosition(gv_hero[lp_owner]), 10.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
    lv_maxcount = (10 + (TechTreeUpgradeCount(lp_owner, "ShadowHeroMidnight", c_techCountQueuedOrBetter) * 2));
    lv_energy = TechTreeUpgradeCount(lp_owner, "ShadowHeroHaunt", c_techCountQueuedOrBetter);

    // Implementation
    SoundPlayAtPointForPlayer(SoundLink("DarkEnergySound", -1), c_maxPlayers, PlayerGroupAll(), UnitGetPosition(gv_hero[lp_owner]), 0.0, 100.0, 0.0);
    while ((UnitGroupCount(lv_targets, c_unitCountAll) >= 1) && (lv_maxcount > 0)) {
        lv_target = UnitGroupRandomUnit(lv_targets, c_unitCountAll);
        lv_maxcount -= 1;
        if ((lv_maxcount >= UnitGroupCount(lv_targets, c_unitCountAlive))) {
            lv_counter += 1;
            if ((lv_counter >= (1 + TechTreeUpgradeCount((lp_owner - 0), "ShadowHeroMidnight", c_techCountQueuedOrBetter)))) {
                UnitGroupRemove(lv_targets, lv_target);
                lv_counter = 0;
            }

        }
        else {
            UnitGroupRemove(lv_targets, lv_target);
        }
        Wait(0.1, c_timeGame);
        gf_Shadowcrash(lv_energy, UnitGetPosition(lv_target), UnitGetPosition(gv_hero[lp_owner]), lp_owner, gv_hero[lp_owner]);
        if ((UnitIsAlive(gv_hero[lp_owner]) == true) && (RandomInt(0, 100) > (100 - (TechTreeUpgradeCount(lp_owner, "ShadowHeroCondemnation", c_techCountQueuedOrBetter) * 33)))) {
            if ((UnitIsAlive(lv_target) == true)) {
                gf_AddShadowEnergy(false, lp_owner, (3 * TechTreeUpgradeCount(lp_owner, "ShadowHeroShadowfury", c_techCountQueuedOrBetter)));
                gf_DoomDetonate(lp_owner, gv_hero[lp_owner], ((TechTreeUpgradeCount(lp_owner, "ShadowHeroDeathsEmbrace", c_techCountQueuedOrBetter) * 45.0) + 150.0), UnitGetPosition(lv_target));
            }

        }

    }
}

