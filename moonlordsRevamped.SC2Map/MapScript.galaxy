//--------------------------------------------------------------------------------------------------
// Trigger: OptionsDialogButtonPressed
//--------------------------------------------------------------------------------------------------
bool gt_OptionsDialogButtonPressed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_optionsDialog))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_optionsExitButton == EventDialogControl())) {
        DialogSetVisible(gv_optionsDialog, PlayerGroupAll(), false);
    }

    if ((gv_optionsPowerSelectCheckbox == EventDialogControl()) && (DialogIsVisible(gv_optionsDialog, EventPlayer()) == true)) {
        if ((gv_zstickselect[EventPlayer()] == true)) {
            gv_zstickselect[EventPlayer()] = false;
            gf_bankaddtoint(gv_zbanks[EventPlayer()], "ps", "option", -1);
        }
        else {
            gv_zstickselect[EventPlayer()] = true;
            gf_bankaddtoint(gv_zbanks[EventPlayer()], "ps", "option", 1);
        }
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/D27441F5"));
        gf_PowerSelect(EventPlayer());
    }

    if ((gv_optionsXPFactorCheckbox == EventDialogControl()) && (DialogIsVisible(gv_optionsDialog, EventPlayer()) == true)) {
        if ((gv_optionXPFactor[EventPlayer()] == true)) {
            gv_optionXPFactor[EventPlayer()] = false;
            gf_bankaddtoint(gv_zbanks[EventPlayer()], "xp", "option", -1);
            DialogControlSetVisible(gv_xpFactorLabel, PlayerGroupSingle(EventPlayer()), false);
        }
        else {
            gv_optionXPFactor[EventPlayer()] = true;
            gf_bankaddtoint(gv_zbanks[EventPlayer()], "xp", "option", 1);
            DialogControlSetVisible(gv_xpFactorLabel, PlayerGroupSingle(EventPlayer()), true);
        }
    }

    if ((gv_optionsGameTimeCheckbox == EventDialogControl()) && (DialogIsVisible(gv_optionsDialog, EventPlayer()) == true)) {
        if ((gv_optionGameTime[EventPlayer()] == true)) {
            gv_optionGameTime[EventPlayer()] = false;
            gf_bankaddtoint(gv_zbanks[EventPlayer()], "gt", "option", -1);
            DialogControlSetVisible(libNtve_gf_ScreenLabelDialogItem(gv_sL_GAMETIME), PlayerGroupSingle(EventPlayer()), false);
        }
        else {
            gv_optionGameTime[EventPlayer()] = true;
            gf_bankaddtoint(gv_zbanks[EventPlayer()], "gt", "option", 1);
            DialogControlSetVisible(libNtve_gf_ScreenLabelDialogItem(gv_sL_GAMETIME), PlayerGroupSingle(EventPlayer()), true);
        }
    }

    return true;
}

