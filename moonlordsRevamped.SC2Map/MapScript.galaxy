    while ((PlayerStatus(lp_player) == c_playerStatusActive) && (gf_achievementgetvalueofnextleveladd(lp_achievementnumber, lp_player, 0) <= lp_amounttocheckfor)) {
        gf_achievementnew(lp_player, lp_achievementnumber);
    }
}

