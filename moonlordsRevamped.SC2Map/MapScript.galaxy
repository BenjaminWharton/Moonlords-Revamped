void gf_CreateUpgrade (int lp_row, int lp_column, text lp_name, text lp_tooltip, string lp_upgrade) {
    // Variable Declarations
    text lv_upgradeName;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_upgradeName = gf_GetUpgradeName(lp_name, lp_upgrade);

    // Implementation
    gv_upgrades[lp_row][lp_column].lv_upgrade = lp_upgrade;
    gv_upgrades[lp_row][lp_column].lv_name = lp_name;
    gv_upgrades[lp_row][lp_column].lv_tooltip = lp_name;
    libNtve_gf_CreateDialogItemButton(gv_upgradeDialog, 400, 50, c_anchorTopLeft, (25 + (lp_column * 400)), (100 + (lp_row * 50)), lp_tooltip, lv_upgradeName, "");
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "MLTalentName", PlayerGroupAll());
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeEndCap, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_battlenet_glue_bluedropdownbuttonsmall_normalpressed.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage2(DialogControlLastCreated(), "Assets\\Textures\\ui_battlenet_glue_bluedropdownbuttonsmall_normaloverpressedover.dds", PlayerGroupAll());
    gv_upgrades[lp_row][lp_column].lv_dialogItem = DialogControlLastCreated();
}

void gf_UpgradePressed (int lp_row, int lp_column) {
    // Variable Declarations
    string lv_upgrade;
    int lv_upgradeLevel;
    int lv_upgradeMax;
    int lv_dialogItem;
    text lv_name;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_upgrade = gv_upgrades[lp_row][lp_column].lv_upgrade;
    lv_upgradeLevel = TechTreeUpgradeCount(gv_aLLIEDPLAYER, lv_upgrade, c_techCountCompleteOnly);
    lv_upgradeMax = CatalogFieldValueGetAsInt(c_gameCatalogUpgrade, lv_upgrade, "MaxLevel", gv_aLLIEDPLAYER);
    lv_dialogItem = gv_upgrades[lp_row][lp_column].lv_dialogItem;
    lv_name = gv_upgrades[lp_row][lp_column].lv_name;

    // Implementation
    if ((lv_upgradeLevel < lv_upgradeMax)) {
        TechTreeUpgradeAddLevel(gv_aLLIEDPLAYER, lv_upgrade, 1);
        libNtve_gf_SetDialogItemText(lv_dialogItem, gf_GetUpgradeName(lv_name, lv_upgrade), PlayerGroupAll());
        gv_upgradesAvailable -= 1;
        if ((TechTreeUpgradeCount(gv_aLLIEDPLAYER, lv_upgrade, c_techCountQueuedOrBetter) == lv_upgradeMax)) {
            DialogControlSetEnabled(gv_upgrades[lp_row][lp_column].lv_dialogItem, PlayerGroupAll(), false);
        }

    }
    libNtve_gf_SetDialogItemText(gv_upgradesLabel, gf_GetUpgradePointsText(), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_resourceLabelUpgrades, IntToText(gv_upgradesAvailable), PlayerGroupAll());
}

trigger auto_gf_laForge_Trigger = null;
unit auto_gf_laForge_lp_forge;

void gf_laForge (unit lp_forge) {
    auto_gf_laForge_lp_forge = lp_forge;

    if (auto_gf_laForge_Trigger == null) {
        auto_gf_laForge_Trigger = TriggerCreate("auto_gf_laForge_TriggerFunc");
    }

    TriggerExecute(auto_gf_laForge_Trigger, false, false);
}

bool auto_gf_laForge_TriggerFunc (bool testConds, bool runActions) {
    unit lp_forge = auto_gf_laForge_lp_forge;

    // Variable Declarations
    int lv_level;
    int lv_value;
    int lv_floattext;
    int lv_floattext2;
    int lv_i;
    int lv_j;
    fixed lv_time;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_value = 500;
    lv_floattext = c_textTagNone;
    lv_floattext2 = c_textTagNone;

    // Implementation
    TextTagCreate(StringExternal("Param/Value/0B69CFE1"), 40, Point(250,9), 1.0, true, false, PlayerGroupAll());
    lv_floattext = TextTagLastCreated();
    TextTagCreate(StringExternal("Param/Value/FF4A3C65"), 30, Point(250,8), 1.0, true, false, PlayerGroupAll());
    lv_floattext2 = TextTagLastCreated();
    while ((lv_level <= 100)) {
        if ((lv_level >= 20) && (lv_level <= 41)) {
            lv_i = 0;
            lv_j = (lv_level-15)/5;
            while ((lv_i < gv_pLAYERCOUNT)) {
                lv_i += 1;
                if ((PlayerStatus(lv_i) == c_playerStatusActive)) {
                    if ((gf_achievementgetlevel(lv_i, 28) < lv_j)) {
                        gf_achievementnew(lv_i, 28);
                    }

                }

            }
        }

        if ((PlayerGetPropertyInt(5, c_playerPropMinerals) >= lv_value)) {
            lv_time = (30.0 / gv_xpboost);
            CatalogFieldValueSet(c_gameCatalogAbil, "ForgeUpgrades", "InfoArray[" + IntToString(0) + "].Time", 5, FixedToString(lv_time, c_fixedPrecisionAny));
            UnitIssueOrder(lp_forge, Order(AbilityCommand("ForgeUpgrades", 0)), c_orderQueueReplace);
            PlayerModifyPropertyInt(5, c_playerPropMinerals, c_playerPropOperSubtract, lv_value);
            lv_value += 250+(lv_level*75);
            TextTagSetText(lv_floattext2, StringExternal("Param/Value/D2CCFB4A"));
            while ((UnitQueueItemCount(lp_forge, 1) > 0)) {
                Wait(0.0625, c_timeGame);
            }
            lv_level += 1;
            Wait(1.0, c_timeGame);
            libNtve_gf_SetUpgradeLevelForPlayer(5, "ForgeMineralUpgrade", lv_level);
            TextTagSetText(lv_floattext, (StringExternal("Param/Value/7F98F8CC") + IntToText(lv_level)));
            TextTagSetText(lv_floattext2, (IntToText(((PlayerGetPropertyInt(5, c_playerPropMinerals) * 100) / lv_value)) + StringExternal("Param/Value/32BE8DD9")));
        }
        else {
            TextTagSetText(lv_floattext2, (IntToText(((PlayerGetPropertyInt(5, c_playerPropMinerals) * 100) / lv_value)) + StringExternal("Param/Value/04B65237")));
            Wait(1.0, c_timeGame);
        }
    }
    TextTagSetText(lv_floattext, StringExternal("Param/Value/2F61AE81"));
    TextTagSetText(lv_floattext2, StringExternal("Param/Value/6A55633A"));
    return true;
}

